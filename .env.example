# Google Gemini API
GOOGLE_API_KEY=sua_chave_do_google_ai_studio_aqui
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL + pgvector
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/publicgov

# Embeddings (padrao leve ou google/embeddinggemma-2 para benchmark/producao)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL=google/embeddinggemma-2
# EMBEDDING_DIM=256
# HF_TOKEN=hf_seu_token_para_modelos_gated

# Busca Hibrida & Reranker
ENABLE_RERANKER=true
RERANKER_MODEL=ms-marco-MultiBERT-L-12

# Langfuse Observability (opcional - deixe vazio para desabilitar)
# Para Cloud: https://cloud.langfuse.com
# Para Docker local (`docker compose --profile langfuse up -d`): http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Opcional: override de preços do LLM em USD por 1M tokens para estimativa de custo
# LLM_INPUT_COST_PER_1M_USD=0.15
# LLM_OUTPUT_COST_PER_1M_USD=0.60
